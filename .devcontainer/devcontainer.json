{
  "name": "OpenSesame Experiments",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/experiments",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/experiments,type=bind,consistency=cached",
  "remoteUser": "ubuntu",

  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-desktop.sh",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "noVNC - OpenSesame GUI",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/ubuntu/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
