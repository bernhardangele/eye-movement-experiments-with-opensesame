%%BeginHeader
Eyetrack reading experiment with a comma manipulation by Bernhard Angele
output from make_script.R
%%EndHeader

set conditions = 2
set experiments = 1
set background =  16777215
set foreground =  0
set filterMode = 2
set windowThreshold = 0
set calibration_type = 0
set display_type = CRT

trial_type question

  text_format =    "Courier New" 14 28 20 216 antialiased

   button =         leftTrigger
  cursor_size =    0
  stimulus_delay = 500
  revert =         0
end question

trial_type sentence
  text_format =    "Courier New" 14 28 40 266 antialiased

   button =         toggle
  cursor_size =    0
  dc_delay =       0
  stimulus_delay = 0
  revert =         0
end sentence

trial_type practice
  text_format =    "Courier New" 14 28 40 266 antialiased
   button =         toggle
  cursor_size =    0
  stimulus_delay = 0
  revert =         0
end practice

